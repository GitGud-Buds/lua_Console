local function generate_Tree(parallel_rounds,halfmove,halfmove_since,divergence,output_tree)
halfmove_since,divergence,output_tree=halfmove_since or 1,divergence or 0,output_tree or{}
local max_halfmoves,diverge=math.huge
for idx=1,#parallel_rounds do
max_halfmoves=#parallel_rounds[idx]-1<max_halfmoves and #parallel_rounds[idx]or max_halfmoves
end
while not diverge and divergence<5 do
halfmove=1+halfmove
if halfmove>=max_halfmoves then
diverge=true
goto sticky_end
end
for i=1,#parallel_rounds do
local j=1+i%#parallel_rounds
if parallel_rounds[i][halfmove]~=parallel_rounds[j][halfmove]then
diverge=true
end
end
if not diverge then
goto next_half
end
::sticky_end::
output_tree.moves={}
for idx=halfmove_since,halfmove-1 do
output_tree.moves[1+#output_tree.moves]=parallel_rounds[1][idx]
end
local set={}
for idx=1,#parallel_rounds do
if set[parallel_rounds[idx][halfmove]]==_ then
set[parallel_rounds[idx][halfmove]]=idx
elseif type(set[parallel_rounds[idx][halfmove]])=="number"then
local trunk={parallel_rounds[set[parallel_rounds[idx][halfmove]]]}
table.insert(trunk,parallel_rounds[idx])
set[parallel_rounds[idx][halfmove]]=trunk
else
table.insert(set[parallel_rounds[idx][halfmove]],parallel_rounds[idx])
end
end
for _,v in next,set do
if type(v)=="number"then
output_tree[1+#output_tree]={moves={}}
for idx=halfmove,#parallel_rounds[v]do
table.insert(output_tree[#output_tree].moves,parallel_rounds[v][idx])
end
else
output_tree[1+#output_tree]=generate_Tree(v,halfmove,halfmove,1+divergence)
end
end
::next_half::
end
if divergence<5 then
return output_tree
end
for idx1=1,#parallel_rounds do
output_tree["moves"..(idx1-1>0 and idx1-1 or"")]={}
for idx2=halfmove_since,#parallel_rounds[idx1]do
table.insert(output_tree["moves"..(idx1-1>0 and idx1-1 or"")],parallel_rounds[idx1][idx2])
end
end
return output_tree
end

