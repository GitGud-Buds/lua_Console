local le,ly,lm,ld=l:match("Event.-\"(%s-%S*%s-)\".-\n"),l:match("Date.-(%d+)%.(%d+)%.(%d+).-\n")
local re,ry,rm,rd=r:match("Event.-\"(%s-%S*%s-)\".-\n"),r:match("Date.-(%d+)%.(%d+)%.(%d+).-\n")
if ly~=ry then
return ly>ry
elseif lm~=rm then
return lm>rm
elseif ld~=rd then
return ld>rd
end
return le<re
end)

io.output(exclude_dir..current_date.year..current_date.month..current_date.day..current_date.hour..current_date.min..current_date.sec..".pgn")
for idx=1,#sorted_headers do
io.write(sorted_headers[idx],"\n\n")
io.write(rounds[sorted_headers[idx]])
if idx<#sorted_headers then
io.write("\n\n")
end
end
io.close()
end