error("Invalid Tree!")
else
round[1+#round]=input_tree.moves
if input_tree.fragments and #input_tree==0 then
output_table[1+#output_table]=table.concat(round).."\t"..input_tree.fragments
else
for idx=1,#input_tree do
output_table=split_Tree(input_tree[idx],output_table,round)
end
end
round[#round]=_
end
return output_table
end

